      "name": "Setup",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Health reports the simulated service\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.status).to.eql(\"ok\");",
                  "    pm.expect(body.simulated).to.eql(true);",
                  "    pm.expect(body.service).to.eql(\"package-sim\");",
                  "    pm.expect(pm.response.headers.get(\"X-Simulated\")).to.eql(\"true\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset seed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/test/reset"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Reset reloads the seed\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.status).to.eql(\"reset\");",
                  "    pm.expect(body.simulated).to.eql(true);",
                  "    pm.expect(pm.response.headers.get(\"X-Simulated\")).to.eql(\"true\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Disable quality_score",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/defects/quality_score",
            "body": {
              "mode": "raw",
              "raw": "{\"enabled\": false}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const forced = String(pm.environment.get(\"forceDefects\") || \"\").toLowerCase() === \"true\";",
                  "if (forced) {",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Disable quality_score so the M1 rule is under test\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.id).to.eql(\"quality_score\");",
                  "    pm.expect(body.enabled).to.eql(false);",
                  "    pm.expect(body.requirement).to.eql(\"REQ-VER-003\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

                  "    pm.expect(pm.response.json().detail).to.include(\"dispute requires a comment\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-VER-013 Resolve the dispute",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/quality/evaluations/{{evalDisputeId}}/resolve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"TC-VER-013 REQ-VER-007 resolve returns the evaluation to under review\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.state).to.eql(\"Under Review\");",
                  "    pm.expect(body.score).to.be.closeTo(100, 0.001);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-VER-014 Coach the resolved evaluation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/quality/evaluations/{{evalDisputeId}}/coach",
            "body": {
              "mode": "raw",
              "raw": "{\"note\": \"Review the greeting.\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"TC-VER-015 REQ-VER-008 coaching keeps the score\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.state).to.eql(\"Coached\");",
                  "    pm.expect(body.score).to.be.closeTo(100, 0.001);",
                  "    pm.expect(body.coaching_note).to.eql(\"Review the greeting.\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-VER-014 Complete the coached evaluation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/quality/evaluations/{{evalDisputeId}}/complete"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"TC-VER-014 REQ-VER-005 a coached evaluation can complete\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.state).to.eql(\"Completed\");",
                  "    pm.expect(body.score).to.be.closeTo(100, 0.001);",
                  "    pm.expect(body.coaching_note).to.eql(\"Review the greeting.\");",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.info.iteration > 0) {",
              "    pm.execution.skipRequest();",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Quality score boundaries",
      "item": [
        {
          "name": "TC-VER-007 Create a threshold evaluation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/quality/evaluations",
            "body": {
              "mode": "raw",
              "raw": "{\"interaction_id\": \"INT-05\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Threshold evaluation is pending\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().state).to.eql(\"Pending\");",
                  "    pm.collectionVariables.set(\"boundaryEvaluationId\", pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-VER-007 Submit the threshold sections",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/quality/evaluations/{{boundaryEvaluationId}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{\"sections\": [{\"id\": \"A\", \"earned\": {{earned_a}}, \"possible\": 2}, {\"id\": \"B\", \"earned\": {{earned_b}}, \"possible\": 1}, {\"id\": \"C\", \"earned\": {{earned_c}}, \"possible\": 1}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const testCase = pm.iterationData.get(\"test_case\");",
                  "const requirement = pm.iterationData.get(\"requirement\");",
                  "pm.test(testCase + \" \" + requirement + \" quality threshold\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.state).to.eql(\"Under Review\");",
                  "    pm.expect(body.score).to.be.closeTo(Number(pm.iterationData.get(\"expected_score\")), 0.001);",
                  "    pm.expect(body.classification).to.eql(pm.iterationData.get(\"expected_classification\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const earned = pm.iterationData.get(\"earned_a\");",
              "if (earned === undefined || earned === null || earned === \"\") {",
              "    pm.execution.skipRequest();",
              "}"
            ]
          }
        }
      ]
    }
  ]
}

            "url": "{{baseUrl}}/api/work/orders",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \" \", \"requester_id\": \"RQ-01\", \"building\": \"HQ\", \"request_class\": \"Electrical\", \"description\": \"Lamp is out.\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC-TRI-001 REQ-TRI-001 a blank title is rejected\", function () {",
                  "    pm.response.to.have.status(422);",
                  "    pm.expect(pm.response.json().detail).to.include(\"Required fields missing\");",
